---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projectEntries = (
    await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const projects = await Promise.all(
    projectEntries.map(async (project) => ({
        ...project,
        Content: (await render(project)).Content,
    })),
);
---

<BaseLayout>
    <section class="flex flex-col gap-y-4">
        <section>
            <h1 class="text-xl font-semibold border-b mb-2">About</h1>

            <section class="flex flex-col gap-y-2">
                <p>
                    I'm Xander, a developer in Edmonton, Alberta, and I like
                    having weird ideas and letting them grow into real work. My
                    interests span software development, hardware engineering,
                    robotics, local inference, and game design, but a lot of
                    what I make still comes down to where the wind takes me.
                </p>

                <p>
                    Beneath the above all being computer-related, I've found
                    that Da Computer has become less the actual <i>subject</i> of
                    my exploration, and more a tool for orchestrating it. <a
                        href="https://softwarequotes.com/quote/everything-really-interesting-that-happens-in-soft"
                        target="_blank"
                        class="underline"
                        >The most interesting things in software always lead
                        back to people</a
                    >, after all.
                </p>
            </section>
        </section>

        <section id="projects">
            <h1 class="text-xl font-semibold border-b mb-2">Projects</h1>
            <ul class="flex flex-col gap-y-3 pt-2">
                {
                    projects.map(({ id, data, Content }) => (
                        <li id={id}>
                            <div class="flex flex-wrap items-baseline gap-x-2">
                                <h2 class="font-semibold">
                                    <a class="underline" href={data.href}>
                                        {data.title}
                                    </a>
                                </h2>
                                {data.repository && (
                                    <a
                                        class="text-sm underline"
                                        href={data.repository}
                                    >
                                        source
                                    </a>
                                )}
                            </div>
                            <p>{data.description}</p>
                            {data.tags.length > 0 && (
                                <p class="text-sm text-slate-600">
                                    {data.tags.join(" · ")}
                                </p>
                            )}
                            {data.writeup && (
                                <details class="mt-2">
                                    <summary class="cursor-pointer underline">
                                        Read the write-up
                                    </summary>
                                    <div class="mt-2 border-l border-slate-300 pl-3 [&_h3]:mt-3 [&_h3]:font-semibold [&_p]:mt-2">
                                        <Content />
                                    </div>
                                </details>
                            )}
                        </li>
                    ))
                }
            </ul>
        </section>

        <section>
            <h1 class="text-xl font-semibold border-b mb-2">Contact</h1>
            <p>
                I like weird propositions; you can send them to me at <a
                    href="mailto:hello@xandwr.com"
                    class="underline">hello@xandwr.com</a
                >.
            </p>
        </section>
    </section>
</BaseLayout>
