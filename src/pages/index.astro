---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (
    await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const projectCategories = [
    {
        id: "tooling",
        title: "Tooling",
        description:
            "Tools I've built for others to use; things I'd consider production-ready.",
    },
    {
        id: "personal",
        title: "Personal",
        description: "Projects related to personal development or exploration.",
    },
    {
        id: "games",
        title: "Games",
        description: "The zany things I can't stop making.",
    },
] as const;
---

<BaseLayout>
    <section class="flex flex-col gap-y-4 w-full m-auto">
        <section class="mx-auto w-full max-w-3xl">
            <section class="flex flex-col gap-y-2 px-2">
                <p>
                    I'm Xander, a developer in Edmonton AB, and I have weird
                    ideas which tend to grow into real work. My interests span
                    software development, hardware engineering, robotics, local
                    inference, and game design, but a lot of what I make still
                    comes down to where the wind takes me.
                </p>

                <p>
                    Beneath the above all being computer-related, I've found
                    that Da Computer has become less the actual <i>subject</i> of
                    my exploration, and more a tool for orchestrating it. <a
                        href="https://softwarequotes.com/quote/everything-really-interesting-that-happens-in-soft"
                        target="_blank"
                        class="underline"
                        >The most interesting things in software always lead
                        back to people</a
                    >, after all.
                </p>
            </section>
        </section>

        <section id="projects" class="">
            <div class="-mx-2 mb-2">
                <h1 class="mx-auto px-2 max-w-3xl text-2xl font-semibold">
                    Projects
                </h1>
            </div>

            <div class="flex flex-col gap-y-4">
                {
                    projectCategories.map((category) => (
                        <section>
                            <div class="-mx-2 border-y bg-slate-200">
                                <div class="mx-auto max-w-3xl px-2">
                                    <h2 class="text-xl font-bold">
                                        {category.title}
                                    </h2>
                                    <p class="italic">{category.description}</p>
                                </div>
                            </div>

                            <ul class="mx-auto flex max-w-3xl flex-col gap-y-3 pt-2 px-2">
                                {projects
                                    .filter(
                                        ({ data }) =>
                                            data.category === category.id,
                                    )
                                    .map(({ id, data }) => (
                                        <li id={id}>
                                            <div class="flex flex-wrap items-baseline gap-x-2">
                                                <h3 class="font-semibold">
                                                    <a
                                                        class="underline"
                                                        href={
                                                            data.writeup
                                                                ? `/projects/${id}`
                                                                : data.href
                                                        }
                                                    >
                                                        {data.title}
                                                    </a>
                                                </h3>
                                                {data.repository && (
                                                    <a
                                                        class="text-sm underline"
                                                        href={data.repository}
                                                    >
                                                        source
                                                    </a>
                                                )}
                                            </div>
                                            <p>{data.description}</p>
                                            {data.tags.length > 0 && (
                                                <p class="text-sm text-slate-600">
                                                    {data.tags.join(" · ")}
                                                </p>
                                            )}
                                            {data.writeup && (
                                                <p class="mt-1">
                                                    <a
                                                        class="underline"
                                                        href={`/projects/${id}`}
                                                    >
                                                        Read the write-up
                                                    </a>
                                                </p>
                                            )}
                                        </li>
                                    ))}
                            </ul>
                        </section>
                    ))
                }
            </div>
        </section>
    </section>
</BaseLayout>
