---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Page not found — xandwr.com"
    description="The requested page could not be found."
    noindex
>
    <section class="mx-auto max-w-2xl py-12 text-center">
        <p class="text-lg text-slate-600 font-serif">404</p>
        <h1 class="mt-1 text-3xl font-bold">Page not found</h1>
        <p class="mt-3">There's nothing here. Are you crazy?</p>
        <p class="mt-4">
            <a class="underline" href="/">Return home</a>
        </p>
    </section>
</BaseLayout>
